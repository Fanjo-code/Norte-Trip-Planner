# Client: use your computer's LAN address for a physical phone.
EXPO_PUBLIC_PROXY_URL=http://localhost:8787

# Local data server
PROXY_PORT=8787

# Optional AI editorial enhancement. These keys stay on the SERVER.
# Live planning works without AI or API keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative OpenAI-compatible local provider (include /v1 if required).
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto/best-free

# --- New AI trip-generation pipeline (server-side only) ---
GEMINI_API_KEY=GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEOAPIFY_API_KEY=PASTE KEY HERE
MAX_ITINERARY_REPAIR_ATTEMPTS=2
