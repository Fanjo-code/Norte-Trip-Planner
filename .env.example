# Norte Trip Planner — Environment Variables
# Copy this to .env and fill in your values

# ============================================
# LOCAL PROXY SERVER (required for live data)
# ============================================
# Port for the local travel data proxy server
PROXY_PORT=8787

# ============================================
# CLIENT (Expo App) - these are bundled into the app
# ============================================
# URL of the local travel data proxy server (use LAN IP for device testing)
# For iOS Simulator: http://localhost:8787
# For physical device: http://YOUR_LAN_IP:8787 (find with ipconfig/ifconfig)
EXPO_PUBLIC_PROXY_URL=http://localhost:8787

# GROQ AI - PRIMARY AI backend (recommended: reliable, own key = dedicated quota)
# Get a free key at https://console.groq.com/keys (no payment needed for free tier)
# This replaces the unreliable shared-free-tier models as the main AI source.
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here
EXPO_PUBLIC_GROQ_MODEL=openai/gpt-oss-120b

# OmniRoute AI Proxy (fallback AI backend - free shared models)
# Runs locally via: omniroute start (port 20128 by default)
# For iOS Simulator: http://localhost:20128
# For physical device: http://YOUR_LAN_IP:20128 (find with ipconfig/ifconfig)
# IMPORTANT: Must use LAN IP when testing on physical device!
EXPO_PUBLIC_OMNIROUTE_BASE_URL=http://localhost:20128
EXPO_PUBLIC_OMNIROUTE_API_KEY=your_omniproxy_token_here
EXPO_PUBLIC_OMNIROUTE_MODEL=opencode/nemotron-3-ultra-free

# ============================================
# NOTES
# ============================================
# 1. Start the travel data proxy: npm run proxy (in Terminal 1)
# 2. Start the app: npm run ios (in Terminal 2)
# 3. (Optional) Start OmniRoute proxy: omniroute start (port 20128) - only as AI fallback
#
# 4. For physical device testing (Expo Go):
#    - Find your LAN IP: ipconfig (Windows) or ifconfig (Mac/Linux)
#    - Update BOTH proxy URLs to http://YOUR_LAN_IP:PORT
#    - Travel data proxy: EXPO_PUBLIC_PROXY_URL=http://YOUR_LAN_IP:8787
#    - AI proxy:       EXPO_PUBLIC_OMNIROUTE_BASE_URL=http://YOUR_LAN_IP:20128
#    - Ensure both proxies bind to 0.0.0.0 (they do by default)
#    - Phone and computer must be on same WiFi
#
# 5. Never commit .env - it's in .gitignore
# 6. AI priority: Groq (primary) -> OmniRoute free models (fallback) -> live data